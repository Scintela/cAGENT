# 编辑器基础一致性:缩进、行尾、编码。排版规则见 .clang-format。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = space
indent_size = 4

[*.{md,mdown}]
trim_trailing_whitespace = false

[*.{sh}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
