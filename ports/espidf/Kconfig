menu "cAgent ESP-IDF Port"

config AGENT_PORT_ESPIDF_RUNTIME
    bool "Build ESP-IDF Runtime adapter"
    default y
    help
      Add the esp_timer based clock builder. This option does not start tasks
      or initialize networking.

config AGENT_PORT_ESPIDF_TRANSPORT
    bool "Build ESP-IDF HTTP Transport adapter"
    default n
    help
      Add the esp_http_client based synchronous HTTP transport.

config AGENT_PORT_ESPIDF_FILE_STORE
    bool "Build ESP-IDF shared byte-file store"
    depends on AGENT_FILE_STORE && AGENT_POSIX_FILE_STORE
    depends on VFS_SUPPORT_IO && VFS_SUPPORT_DIR
    default n
    help
      Bind a trusted application-mounted VFS directory to byte-file ops.
      Supports bounded text loading and optional JSONL binding. No mount or
      format operations are performed. Validate filesystem calls on target.

config AGENT_PORT_ESPIDF_STORAGE
    bool "Build ESP-IDF JSONL Session file binding"
    depends on AGENT_SESSION_JSONL && AGENT_SESSION_POSIX_FILES
    default n
    help
      Bind JSONL file operations to an application-mounted ESP-IDF VFS
      directory. The library does not mount or format the filesystem.

endmenu
