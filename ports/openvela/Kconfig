menu "cAgent OpenVela Port"

config AGENT_PORT_OPENVELA_RUNTIME
    bool "Build OpenVela monotonic-clock Runtime"
    default n
    help
      Add the allocation-free CLOCK_MONOTONIC Runtime builder. Applications
      may separately provide logging and cross-task cancel synchronization.

config AGENT_PORT_OPENVELA_TRANSPORT
    bool "Build OpenVela webclient HTTP Transport"
    depends on NETUTILS_WEBCLIENT
    default n
    help
      Add the synchronous NuttX webclient HTTP adapter. HTTPS additionally
      needs an application-supplied authenticated webclient TLS implementation.

config AGENT_PORT_OPENVELA_FILE_STORE
    bool "Build OpenVela shared byte-file store"
    depends on AGENT_FILE_STORE
    depends on !DISABLE_MOUNTPOINT
    default n
    help
      Bind one trusted mounted directory to byte-file operations. This
      independently selectable package has no JSONL or JSON dependency.
      Validate filesystem support and durability on the target device.

config AGENT_PORT_OPENVELA_STORAGE
    bool "Build OpenVela JSONL Session file binding"
    depends on AGENT_SESSION_JSONL
    default n
    help
      Bind JSONL file operations to an application-mounted NuttX filesystem.
      This option also compiles the shared POSIX file implementation.

endmenu
